{
  "version": 2,
  "installCommand": "python -m pip install --break-system-packages -r requirements.txt",
  "buildCommand": "python -m compileall api backend -q",
  "builds": [
    { "src": "api/index.py", "use": "@vercel/python" }
  ],
  "routes": [
    { "src": "/(.*)", "dest": "/api/index.py" }
  ]
}
